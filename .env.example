# Development only. Do not commit real secrets or credentials.
APP_ENV=development
APP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ajirascan:change-me@127.0.0.1:5432/ajirascan?sslmode=disable
POSTGRES_USER=ajirascan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ajirascan
TRUSTED_ORIGINS=http://localhost:8080
SESSION_TTL=24h
COOKIE_SECURE=false
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60
STORAGE_DRIVER=local
AI_PROVIDER=disabled
AI_MODEL=
PAYMENT_PROVIDER=disabled
